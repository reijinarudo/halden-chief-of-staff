# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here is required to run the stack: the voice line falls back to a
# local voice when no key is present.

# ElevenLabs API key, for the premium voice. Optional.
# On Windows this environment variable is the only supported source.
# On macOS the key is read from the Keychain item `backtalk-elevenlabs`,
# and on Linux from secret-tool, in both cases ahead of this variable.
# Get a key at https://elevenlabs.io. Pick a voice in your own library and
# put its id in backtalk/backtalk.json, not here.
ELEVENLABS_API_KEY=

# Optional override: point the face widget at a config file elsewhere.
# FACE_WIDGET_CONFIG=

# Optional override: point backtalk at a config file elsewhere.
# BACKTALK_CONFIG=
